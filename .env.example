# Optional. Blank token uses the existing ungated QC fallback.
EMOLABEL_HF_TOKEN=

# auto: Apple Silicon -> mlx; Linux x86_64 -> faster-whisper
EMOLABEL_ASR_BACKEND=auto
# Leave model unset for the backend-specific Whisper turbo model.
# EMOLABEL_ASR_MODEL=turbo
EMOLABEL_ASR_DEVICE=cpu
EMOLABEL_ASR_COMPUTE_TYPE=int8
EMOLABEL_ASR_CPU_THREADS=4

# Separate data directories for annotators on the shared PC.
# EMOLABEL_DATA_DIR=/absolute/path/to/your/own/data
# ffmpeg/ffprobe are discovered from PATH unless overridden.
# EMOLABEL_FFMPEG=/usr/bin/ffmpeg
# EMOLABEL_FFPROBE=/usr/bin/ffprobe
